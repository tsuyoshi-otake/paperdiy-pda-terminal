CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# PaperDIY: ESP32-S3-WROOM-1-N16R8 (octal PSRAM is required by the e-paper driver)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y

# Bluetooth: BLE only (ESP32-S3 has no Classic), Bluedroid host for the HID host component
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16
CONFIG_BT_SMP_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y

# Wi-Fi + BLE coexistence
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Internal RAM is the scarce resource with Wi-Fi + BLE + the e-paper driver (24 KB free after start in 0.3.0, and an
# SSH login ran out). An SSH terminal needs little Wi-Fi throughput: fewer static RX buffers (internal DMA memory)
# and no Wi-Fi code in IRAM; small mallocs (libssh2) go to PSRAM above 512 bytes.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

# mbedTLS features used by libssh2 (ECDH/ECDSA P-256, RSA, AES-CTR, SHA-1/256/512, MD5;
# AES-CTR and PK parsing are always on in the mbedTLS 3 that ships with ESP-IDF 5.5)
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=y
CONFIG_MBEDTLS_SHA512_C=y
CONFIG_MBEDTLS_RIPEMD160_C=y
CONFIG_MBEDTLS_DES_C=y
CONFIG_MBEDTLS_PEM_PARSE_C=y
# mbedTLS (libssh2's key exchange: big-number work) allocates from PSRAM: internal RAM is needed by Wi-Fi + BLE
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# microSD (FAT, UTF-8 long names) for SSH keys
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Reproducible build: no dates, times or build paths in the image, and a fixed version (version.txt), so the same
# sources + ESP-IDF v5.5.6 + fetch_deps.sh give a byte-identical binary (checked against prebuilt/SHA256SUMS)
CONFIG_APP_REPRODUCIBLE_BUILD=y
